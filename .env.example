# Local Docker PostgreSQL defaults
POSTGRES_DB=failforward
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Local Docker datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/failforward
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# If the team switches to Supabase managed PostgreSQL,
# replace only the three datasource values above.
# Example:
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<supabase-db-password>

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081
JWT_SECRET=change-me-to-a-strong-secret-key
OPENAI_API_KEY=
