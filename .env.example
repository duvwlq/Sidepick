CLAUDE_MODEL_DEV=claude-haiku-4-5
CLAUDE_MODEL_PROD=claude-sonnet-4-6
PROMPT_VERSION=agent_c_v1
USE_MOCK_LLM=false
DAILY_TOKEN_LIMIT_USER=10000
DAILY_COST_CAP_USER=0.50
DAILY_COST_CAP_SERVICE=5.00
MAX_ITERATIONS=7
RESPONSE_TIMEOUT_SEC=30
AI_CHAT_MAX_INPUT_CHARS=500
AI_CHAT_ROUTE_SHORT_QUERY_CHARS=30
AI_TOKEN_WARN_THRESHOLD_RATIO=0.8
AI_TOKEN_BLOCK_THRESHOLD_RATIO=1.0
AI_STREAM_ENABLED=true
AI_CASE_CACHE_TTL_SEC=86400
AI_STATS_CACHE_TTL_SEC=604800
AI_QUEUE_MAX_SIZE=100
